# Copy to .env.local and fill in. See docs/ENVIRONMENT.md for where each value comes from.
# Generate AWS public lines from a deployed stack: node scripts/print-dotenv-local-from-stack.mjs

# --- Next.js: AWS backend (from CloudFormation outputs ApiUrl, UserPoolId, UserPoolClientId, Region) ---
NEXT_PUBLIC_USE_AWS_BACKEND="true"
NEXT_PUBLIC_AWS_API_URL=""
NEXT_PUBLIC_AWS_REGION="us-east-1"
NEXT_PUBLIC_COGNITO_REGION=""
NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=""
# Amplify / Vercel: set the same NEXT_PUBLIC_* lines in the host’s environment UI — static export bakes them at build time; .env.local alone does not apply there.
# Optional server-side fallbacks (see lib/cognito-config.ts)
COGNITO_REGION=""
AWS_REGION=""
COGNITO_USER_POOL_ID=""
COGNITO_USER_POOL_CLIENT_ID=""

# Comma-separated admin emails (shows "Users" in header; must match Lambda ADMIN_EMAILS after deploy).
# Example: ojashealth2026@gmail.com or ojashealth2026@gmail.com,you@example.com
NEXT_PUBLIC_ADMIN_EMAILS=""

# --- Insights feature flags (Next + legacy names; Lambda uses INSIGHTS_LLM_REFINE + /feature-flags) ---
NEXT_PUBLIC_INSIGHTS_V2_ENABLED="true"
NEXT_PUBLIC_INSIGHTS_LLM_REFINE="true"
FF_INSIGHTS_V2="true"
FF_INSIGHTS_LLM_REFINE="true"
NEXT_PUBLIC_FF_INSIGHTS_V2="true"
NEXT_PUBLIC_FF_INSIGHTS_LLM_REFINE="true"
NEXT_PUBLIC_INSIGHTS_SOURCE_LABEL="true"
FF_INSIGHTS_SOURCE_LABEL="true"
NEXT_PUBLIC_FF_INSIGHTS_SOURCE_LABEL="true"

# --- Billing (Stripe; server routes under app/api/v2/billing/) ---
FF_BILLING_ENABLED="true"
NEXT_PUBLIC_FF_BILLING_ENABLED="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_FAMILY_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
# If running Next server against real DynamoDB billing tables:
SUBSCRIPTIONS_TABLE_NAME=""
BILLING_EVENTS_TABLE_NAME=""

# --- P1.3 photo food logging (vision). Lambda: FF_PHOTO_FOOD_LOG at CDK deploy (opt-out: omit or !=false => true). ---
FF_PHOTO_FOOD_LOG="true"
NEXT_PUBLIC_FF_PHOTO_FOOD_LOG="true"

# --- P1.3.1 meal library. Lambda: FF_MEAL_LIBRARY at CDK deploy. ---
FF_MEAL_LIBRARY="true"
NEXT_PUBLIC_FF_MEAL_LIBRARY="true"

# Natural-language meal logging (separate Lambda meal-nl-parse). Requires ANTHROPIC_API_KEY on that Lambda.
FF_NL_MEAL_PARSE="true"
NEXT_PUBLIC_FF_NL_MEAL_PARSE="true"
# AI progress-photo visual compare assessment (estimate-only)
FF_BODY_COMPARE_AI="true"
NEXT_PUBLIC_FF_BODY_COMPARE_AI="true"
# Personalized coaching nudges on GET /v2/insights (Pro-gated). CDK: opt-out (omit or !=false => true).
FF_PERSONALIZED_AI_COACHING="true"
NEXT_PUBLIC_FF_PERSONALIZED_AI_COACHING="true"
# Voice daily check-in (browser speech-to-text; production uses AWS API Gateway only). Default on when unset (opt-out below).
# Optional: allow same-origin /api/v2/voice-daily-log/parse fallback on non-localhost (static export has no API routes).
# NEXT_PUBLIC_VOICE_PARSE_ALLOW_NEXT_FALLBACK="true"
# FF_VOICE_DAILY_LOGGING="false"
# NEXT_PUBLIC_FF_VOICE_DAILY_LOGGING="false"
# Optional model for voice parse (default: claude-haiku-4-5 in code).
# ANTHROPIC_VOICE_DAILY_MODEL=""
# Optional model for nl-parse Lambda (default: claude-sonnet-4-20250514).
# ANTHROPIC_NL_MEAL_MODEL=""

# --- Anthropic (never commit real keys) ---
# Required for `npm run infra:cdk:deploy` / `infra:cdk:synth` — CDK fails fast if unset (see infra/cdk/bin/backend-foundation.ts).
# Put your real key in .env.local only. For template-only synth without a key: CDK_ALLOW_MISSING_ANTHROPIC_API_KEY=true (not for prod).
ANTHROPIC_API_KEY=""
# CDK_ALLOW_MISSING_ANTHROPIC_API_KEY="true"
# Optional vision model; Lambda default is set in code if empty.
ANTHROPIC_FOOD_VISION_MODEL=""
# Optional; AI insights card reads on Lambda (default model in insights-ai-card if unset).
ANTHROPIC_INSIGHTS_MODEL=""
# Local Next server if using insight cache DynamoDB:
INSIGHT_CACHE_TABLE_NAME=""

# --- CDK deploy shell (not needed in .env.local unless you use a tool that loads it) ---
# ADMIN_EMAILS="ojashealth2026@gmail.com"
# SES verified identity for weekly/digest email From (defaults in CDK to ojashealth2026@gmail.com if unset):
# TRANSACTIONAL_EMAIL_FROM="ojashealth2026@gmail.com"
# INSIGHTS_LLM_REFINE="true"

# --- Analytics & misc ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_COST_DASHBOARD_URL=""

# --- CDK deploy (shell env when running cdk deploy): S3 photo upload CORS ---
# Comma-separated extra https origins (Amplify previews, staging domains):
# PHOTO_CORS_EXTRA_ORIGINS=https://main.d1234567890.amplifyapp.com
# Test portal only — S3 allows any browser Origin for presigned PUT/GET (do not use in production):
# PHOTO_CORS_ALLOW_ALL_ORIGINS=true

# --- Scripts only ---
# DATABASE_URL=""          # scripts/verify-persistent-db.mjs
# CDK_STACK_NAME=""        # default DietTrackerBackendFoundation
# AMPLIFY_APP_ID=""        # scripts/stage6-validate-cutover.mjs
# AMPLIFY_BRANCH=""
# SMOKE_TEST_EMAIL=""
# SMOKE_TEST_PASSWORD=""
# ENTRIES_TABLE_NAME=""    # scripts/backfill-set-alcohol-false.mjs
# TARGET_USER_ID=""
# FROM_DATE=""
# DRY_RUN=""
