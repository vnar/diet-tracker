# Copy to .env — or generate from your deployed stack (needs AWS CLI):
#   node scripts/print-mobile-dotenv-from-stack.mjs > mobile/.env
# Values match web .env.local (NEXT_PUBLIC_* → EXPO_PUBLIC_*). EAS: set the same EXPO_PUBLIC_* as secrets.

EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_USE_AWS_BACKEND=true
EXPO_PUBLIC_AWS_API_URL=https://your-api.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_AWS_REGION=us-east-1

EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Optional — same project as web (posthog-js)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional crash reporting (DSN only; org/project for source maps via Sentry wizard / CI)
EXPO_PUBLIC_SENTRY_DSN=
